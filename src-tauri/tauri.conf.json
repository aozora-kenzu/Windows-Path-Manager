{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowsPathManager",
  "version": "0.1.0",
  "identifier": "dev.portable.windows-path-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WindowsPathManager",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
